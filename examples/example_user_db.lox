class User {
  init(name, email) {
    this.name = name;
    this.email = email;
  }

  display() {
    println("User:", this.name, "(", this.email, ")");
  }
}

fun createUser() {
  var userName = input("Enter name: ");
  var userEmail = input("Enter email: ");
  return User(userName, userEmail);
}

var user1 = createUser();
user1.display();

var user2 = createUser();
user2.display();
